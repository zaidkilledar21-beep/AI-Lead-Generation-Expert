    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "deepSeekApi",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ \n  JSON.stringify({\n    model: \"deepseek-chat\",\n    response_format: {\n      type: \"json_object\"\n    },\n    messages: [\n      {\n        role: \"system\",\n        content: \"You generate safe cold outreach email drafts for an automation agency. Return JSON only. Never send emails. Never invent facts. Only use evidence provided in the context. If evidence is insufficient, return valid=false with a block_reason.\"\n      },\n      {\n        role: \"user\",\n        content: $json.prompt\n      }\n    ]\n  })\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        288,
        -64
      ],
      "id": "db591b8c-2a73-41c2-89b7-586728e0d77a",
      "name": "DeepSeek Draft JSON",
      "credentials": {
        "deepSeekApi": {
          "id": "aNfM8oqYzENtLlRm",
          "name": "DeepSeek account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const contexts = $(\"Load Draft Context\").all().map((item) => item.json || {});\nconst responses = $input.all();\n\nreturn responses.map((item, index) => {\n  const context = contexts[index] || {};\n  const deepseek = item.json || {};\n  let draft;\n\n  try {\n    const content = deepseek.choices?.[0]?.message?.content;\n    if (typeof content === \"string\") draft = JSON.parse(content);\n    else if (typeof content === \"object\" && content !== null) draft = content;\n    else draft = { valid: false, block_reason: \"deepseek_response_missing_content\" };\n  } catch {\n    draft = { valid: false, block_reason: \"deepseek_response_not_valid_json\" };\n  }\n\n  const evidence = context.evidence || [];\n  const step = context.step || {};\n  const score = context.score || {};\n  const lead = context.lead || {};\n  const queue = context.queue || {};\n  const errors = [];\n\n  if (!Array.isArray(evidence) || evidence.length === 0) errors.push(\"missing_score_evidence\");\n  if (!draft.subject || String(draft.subject).trim().length === 0) errors.push(\"missing_subject\");\n  if (!draft.body || String(draft.body).trim().length === 0) errors.push(\"missing_body\");\n  if (draft.subject && String(draft.subject).length > 70) errors.push(\"subject_too_long\");\n  if (draft.body && String(draft.body).split(/\\s+/).filter(Boolean).length > 160) errors.push(\"body_too_long\");\n  if (!draft.observation_used || String(draft.observation_used).trim().length < 10) errors.push(\"missing_observation\");\n  if (!draft.automation_idea || String(draft.automation_idea).trim().length < 10) errors.push(\"missing_automation_idea\");\n  if (!draft.cta || String(draft.cta).trim().length < 5) errors.push(\"missing_cta\");\n\n  const forbidden = [\"guaranteed\", \"i noticed your business is struggling\", \"you are losing customers\", \"we can 10x\", \"limited time offer\", \"act now\", \"free money\", \"risk-free\"];\n  const combined = `${draft.subject || \"\"} ${draft.body || \"\"}`.toLowerCase();\n  for (const phrase of forbidden) if (combined.includes(phrase)) errors.push(`forbidden_phrase:${phrase}`);\n\n  const hasLink = /https?:\\/\\//i.test(draft.body || \"\");\n  const stepAllowsLink = step.allow_link === true || step.requires_link === true || step.include_link === true;\n  if (hasLink && !stepAllowsLink) errors.push(\"link_not_allowed_for_step\");\n\n  const isValid = draft.valid === true && errors.length === 0;\n  return {\n    json: {\n      queue_id: queue.id,\n      lead_id: lead.id || queue.lead_id,\n      band: score.band,\n      step_number: queue.current_step,\n      draft,\n      validation_errors: errors,\n      is_valid: isValid,\n      approval_status: isValid && score.band === \"A\" && queue.current_step === 1 ? \"pending\" : isValid ? \"auto_approved\" : \"blocked\"\n    },\n    pairedItem: { item: index }\n  };\n});",
        "mode": "runOnceForAllItems"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        -64
      ],
      "id": "1dd031fd-16ad-4d31-81af-5d470c9e3f0d",
      "name": "Validate Draft"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/persist_draft_or_block",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{\n  JSON.stringify({\n    p_queue_id: $json.queue_id,\n    p_lead_id: $json.lead_id,\n    p_is_valid: Boolean($json.is_valid),\n    p_subject: $json.draft?.subject || null,\n    p_body: $json.draft?.body || null,\n    p_channel: $json.draft?.channel || \"email\",\n    p_approval_status: $json.approval_status || ($json.is_valid ? \"auto_approved\" : \"blocked\"),\n    p_block_reason: Array.isArray($json.validation_errors) && $json.validation_errors.length > 0\n      ? $json.validation_errors.join(\", \")\n      : ($json.draft?.block_reason || null),\n    p_raw_draft: $json.draft || {}\n  })\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        704,
        -64
      ],
      "id": "c871fa48-8154-43c0-ad76-76f3c221af76",
      "name": "Persistent Draft or Block",
      "credentials": {
        "supabaseApi": {
          "id": "G2PWTNFTSzofNG19",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const context = $json || {};\n\nconst prompt = `\nCreate an outreach draft using this context:\n\n${JSON.stringify(context, null, 2)}\n\nReturn this exact JSON shape:\n{\n  \"valid\": true,\n  \"channel\": \"email\",\n  \"subject\": \"\",\n  \"body\": \"\",\n  \"observation_used\": \"\",\n  \"automation_idea\": \"\",\n  \"cta\": \"\",\n  \"risk_notes\": [],\n  \"block_reason\": null\n}\n\nRules:\n- Plain text only.\n- No false claims.\n- Do not invent company facts, metrics, tools, problems, names, clients, locations, or technologies.\n- Use only evidence present in the context.\n- Mention one real observation from the context if available.\n- Mention one specific automation idea tied to the observation.\n- Include one soft CTA.\n- No aggressive sales language.\n- No fake familiarity.\n- No fake case studies.\n- Body under 160 words.\n- Subject under 70 characters.\n- Do not include links unless the outreach step explicitly requires one.\n- If context or evidence is insufficient, return valid=false and explain block_reason.\n`.trim();\n\nreturn {\n  json: {\n    ...context,\n    prompt\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
