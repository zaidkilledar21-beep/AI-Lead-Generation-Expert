# Supabase browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/n8n only. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# AI
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Workspace / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OUTREACH_INBOX=

# Google Places discovery MVP. Server/n8n only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TEXT_SEARCH_FIELD_MASK=places.id,nextPageToken
GOOGLE_PLACES_ALLOWED_FIELD_MASK=id,displayName,formattedAddress,nationalPhoneNumber,websiteUri,rating,userRatingCount,googleMapsUri
GOOGLE_PLACES_DAILY_DISCOVERY_RUN_CAP=1
MAX_FINAL_LEADS_PER_DAY=30
MAX_CANDIDATES_CHECKED_PER_DAY=75
MAX_PLACES_DETAILS_CALLS_PER_DAY=100
MAX_TOTAL_PLACES_CALLS_PER_DAY=150

# VPS website crawl guardrails
CRAWL_MAX_PAGES_PER_LEAD=6
CRAWL_MAX_DEPTH=1
CRAWL_TIMEOUT_MS=12000
CRAWL_MAX_BYTES_PER_PAGE=500000
CRAWL_BLOCK_MEDIA=true

# n8n
APP_BASE_URL=https://your-app.example.com
N8N_BASE_URL=
N8N_API_KEY=
# Optional compatibility alias for existing n8n containers. Prefer N8N_API_KEY.
N8N_WORKFLOW_API_KEY=
N8N_DISCOVERY_WEBHOOK_URL=
N8N_DISCOVERY_WEBHOOK_PATH=/webhook/wf-10-lead-discovery
N8N_ENCRYPTION_KEY=

# Dashboard auth
DASHBOARD_BASIC_AUTH_USER=
DASHBOARD_BASIC_AUTH_PASSWORD=

# Notifications
NOTIFICATION_EMAIL_TO=
FOUNDER_NOTIFICATION_EMAIL=
FOUNDER_NOTIFY_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Outreach controls
GLOBAL_OUTREACH_PAUSED=true
